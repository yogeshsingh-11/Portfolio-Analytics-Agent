# Copy to .env and fill in. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Optional: any Gemini model that supports function calling
GEMINI_MODEL=gemini-3.1-flash-lite
# Cap model "thinking" for speed (minimal|low|medium|high). Unset = model default.
GEMINI_THINKING_LEVEL=low
# Optional: separate model for SQL writing only (routing uses GEMINI_MODEL)
# GEMINI_SQL_MODEL=
